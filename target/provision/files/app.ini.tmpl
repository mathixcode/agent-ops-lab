APP_NAME = Target Lab Git
RUN_USER = git
RUN_MODE = prod
WORK_PATH = /var/lib/gitea

[server]
PROTOCOL = http
HTTP_ADDR = 127.0.0.1
HTTP_PORT = 3000
DOMAIN = @HOSTNAME@
ROOT_URL = https://@HOSTNAME@/
DISABLE_SSH = true
OFFLINE_MODE = true
LFS_START_SERVER = false

[database]
DB_TYPE = postgres
HOST = 127.0.0.1:5432
NAME = gitea
USER = gitea
PASSWD = @DB_PASSWORD@
SSL_MODE = disable

[repository]
ROOT = /var/lib/gitea/data/gitea-repositories
DEFAULT_BRANCH = main

[security]
INSTALL_LOCK = true
SECRET_KEY = @SECRET_KEY@
INTERNAL_TOKEN = @INTERNAL_TOKEN@
PASSWORD_HASH_ALGO = pbkdf2
; Outbound calls made by Gitea itself (webhooks, OAuth2): public hosts only.
; Non-public targets need an explicit entry in ALLOWED_HOST_LIST.
EGRESS_MODE = lax
ALLOWED_HOST_LIST =

[oauth2]
JWT_SECRET = @JWT_SECRET@

[service]
DISABLE_REGISTRATION = true
REQUIRE_SIGNIN_VIEW = true
ENABLE_NOTIFY_MAIL = false
DEFAULT_KEEP_EMAIL_PRIVATE = true

[openid]
ENABLE_OPENID_SIGNIN = false
ENABLE_OPENID_SIGNUP = false

[mailer]
ENABLED = false

[session]
PROVIDER = db
COOKIE_SECURE = true

[cache]
ADAPTER = memory

[log]
MODE = console
LEVEL = Info

[actions]
ENABLED = false

[packages]
ENABLED = false

[cron.update_checker]
ENABLED = false
