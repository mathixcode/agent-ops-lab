# Copy to .env (git-ignored). labctl.py reads it; the shell environment overrides it.
# The model credential is the only real credential in the lab and reaches the defender only.

# ---- Model credential: set EXACTLY ONE (labctl refuses to start the lab if both are set)
# a) API key — billed per token through the Anthropic API
ANTHROPIC_API_KEY=
# b) Subscription OAuth token, created with `claude setup-token` on a machine where you are
#    logged in to Claude. With it, ANTHROPIC_API_KEY is removed from the defender entirely, so
#    nothing can fall back to API billing. Subscription usage limits apply: a long run with
#    frequent check-ins can hit them (docs/DOCUMENTATION.md, "The agent").
CLAUDE_CODE_OAUTH_TOKEN=

# Defender driver: "sdk" (Claude Agent SDK, the study subject) or "scripted" (no-LLM harness test stand-in)
DEFENDER_DRIVER=sdk
# Model used when a manifest says `model_defender: claude`
DEFENDER_MODEL_ID=claude-opus-5-5
# Check-in interval of the agent, seconds (default 300). Note: compose.yaml does not pass it into
# the defender container yet, so setting it here currently has no effect.
#DEFENDER_TICK_SECONDS=300

# Target VM size. Spec guideline is 4 vCPU / 8 GB / 40 GB; lower it on small hosts.
TARGET_VCPUS=4
TARGET_MEMORY_MB=8192
TARGET_DISK_GB=40

# KVM is used automatically when the host has /dev/kvm. LAB_KVM=0 stops labctl from passing the device
# in; the hypervisor still uses KVM if it can create the device node itself (docs/DOCUMENTATION.md,
# "KVM and TCG").
#LAB_KVM=0

# Langfuse web UI for an SSH tunnel: OFF by default. When 1, published on 127.0.0.1 only.
#LAB_LANGFUSE_UI=1
#LANGFUSE_UI_PORT=3000
