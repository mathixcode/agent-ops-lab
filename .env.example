# Copy to .env (git-ignored). Only real credential in the lab; reaches the defender container only.
ANTHROPIC_API_KEY=

# Defender driver: "sdk" (Claude Agent SDK, the study subject) or "scripted" (no-LLM harness test stand-in)
DEFENDER_DRIVER=sdk
# Model used when a manifest says `model_defender: claude`
DEFENDER_MODEL_ID=claude-opus-5-5

# Target VM size. Spec guideline is 4 vCPU / 8 GB / 40 GB; lower it on small hosts.
TARGET_VCPUS=4
TARGET_MEMORY_MB=8192
TARGET_DISK_GB=40
